            "source": [
                "#Loop through each participant   \n",
                "for participant in file_list:\n",
                "\n",
                "    print(\"Current participant:\", participant)\n",
                "    print(                     \"Co-registering FMR to VMR with IIHC\")\n",
                "\n",
                "    #BV folder for analysis D:\\BV_Data\\306\\306_FirstSteps\n",
                "    BV_folder = f'{og_location}/{participant}/{participant}_FirstSteps/';\n",
                "    \n",
                "    #Get og functional file of first run for coregistration, of type 201_3T_FoodBrain_Part1L_01.fmr\n",
                "    fmr_file = f'{participant}_3T_FoodBrain_Part2S_01.fmr'\n",
                "    \n",
                "    #Get Tal anatomy file for coregistration, of type 201_3T_FoodBrain_Part1L_IIHC_aTAL.vmr   \n",
                "    #doc_talvmr = f'{participant}_3T_FoodBrain_Part1L_IIHC_aTal.vmr'\n",
                "    \n",
                "    #Should this be the non-tal VMR instead?\n",
                "    doc_notalvmr = f'{participant}_3T_FoodBrain_Part2S_IIHC.vmr'\n",
                "    \n",
                "    #Open TAL VMR file\n",
                "    #doc_tal_vmr = bv.open('D:/LeoData/Raw_data/201/201_FirstAnalysis/201_3T_FoodBrain_Part1L_IIHC_aTAL.vmr')\n",
                "    doc_vmr = bv.open(f'{BV_folder}{doc_notalvmr}')\n",
                "    ok_coreg = doc_vmr.coregister_fmr_to_vmr(f'{BV_folder}{fmr_file}', True)\n",
                "    "
            ]
        },
