            "source": [
                "## Links PRT to FMR\n",
                "\n",
                "#Loop through each participant name\n",
                "for participant in file_list:\n",
                "    \n",
                "    print(\"For participant:\", participant)\n",
                "    \n",
                "    #BV folder directory per participant for analysis D:\\BV_Data\\306\\306_FirstSteps\n",
                "    participant_base = f'{BV_data}/{participant}/{participant}_FirstSteps/';\n",
                "    \n",
                "    #PRT folder location\n",
                "    prt_folder = f'{BV_data}/{participant}';\n",
                "    \n",
                "    # Change the current working directory to the participant's base\n",
                "    #os.chdir(participant_base)\n",
                "    \n",
                "    #Every file base/prefix\n",
                "    file_base = f'{participant}_3T_FoodBrain'\n",
                "    \n",
                "    #preprocessed prefix\n",
                "    process = \"_SCCTBL_3DMCTS_THPGLMF3c\"\n",
                "    \n",
                "    #Loop through each run\n",
                "    for run in range(1, 5):\n",
                "        run_str = f\"{run:02}\"  # Format the value with leading zeros\n",
                "        print(\"                    Current run:\", run_str) \n",
                "        \n",
                "        #Open preprocessed FMR file\n",
                "        doc_open = f'{participant_base}{file_base}_{run_str}{process}.fmr'\n",
                "        doc_fmr = bv.open(doc_open)\n",
                "        \n",
                "        #PRT expected file of type S201_run1\n",
                "        prt_file = f'{prt_folder}/{participant}_run{run}.prt'\n",
                "        \n",
                "        doc_fmr.link_protocol(prt_file) # only documented as a fmr function\n",
                "        \n",
                "        save_fmr = doc_fmr.save() # have to provide file name as str with forward slash; does not take pathlib object\n",
                "        \n",
                "        print(\"FMR with protocol saved: \", save_fmr)\n",
                "            \n",
                "        doc_fmr.close()\n",
                "        \n",
                "        #Open normal FMR file\n",
                "        #doc_open = f'{participant_base}{file_base}_{run_str}.fmr'\n",
                "        #doc_fmr_norm = bv.open(doc_open)\n",
                "        \n",
                "        #PRT expected file of type S201_run1\n",
                "        #prt_file = f'{prt_folder}{participant}_run{run}.prt'\n",
                "        \n",
                "        #linked_prt = doc_fmr_norm.link_protocol(prt_file) # only documented as a fmr function\n",
                "        \n",
                "        #save_fmr = doc_fmr_norm.save() # have to provide file name as str with forward slash; does not take pathlib object\n",
                "        \n",
