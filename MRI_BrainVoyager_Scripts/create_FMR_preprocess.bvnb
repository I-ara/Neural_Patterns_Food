                    ]
                }
            ],
            "source": [
                "# List of folders with participant names \n",
                "file_list = os.listdir();\n",
                "\n",
                "print(\"The participants in this list are:\", file_list)"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 38,
            "metadata": {
            },
            "outputs": [
            ],
            "source": [
                "#Size specs for this dataset\n",
                "\n",
                "nr_slices = 62\n",
                "in_plane_res = (104, 104)\n",
                "\n",
                "# mosaic size: dimension of images in volume along x-axis/y-axis \n",
                "# should be the same thing as number of rows/columns in BV wizard - in this case 832\n",
                "size = int(round(math.sqrt(nr_slices))) * in_plane_res[0] "
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 41,
            "metadata": {
            },
            "outputs": [
                {
                    "name": "stdout",
                    "output_type": "stream",
