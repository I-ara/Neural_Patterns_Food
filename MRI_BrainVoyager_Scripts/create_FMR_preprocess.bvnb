            "source": [
                "#Source file location\n",
                "og_location = \"D:/BV_Data\";\n",
                "\n",
                "# Change the current working directory\n",
                "os.chdir(og_location)\n",
                "\n",
                "# Print the current working directory\n",
                "print(\"Current working directory: {0}\".format(os.getcwd()))"
            ]
