                        "        Correcting Slice Timing using Time Table...\n",
                        "          Motion correction to volume 0 of self...\n",
                        "        Temporal High Pass Filtering with 3 Cycles..."
                    ]
                }
            ],
            "source": [
                "#Loop through each participant   \n",
                "for participant in file_list:\n",
                "\n",
                "    print(\"Current participant:\", participant)\n",
                "    \n",
                "    #Raw Functional Data folder D:\\BV_Data\\306\\306_DCMs\\Functional\n",
                "    raw_func_folder = f'{og_location}/{participant}/{participant}_DCMs/Functional/';\n",
                "\n",
                "    #BV folder for analysis D:\\BV_Data\\306\\306_FirstSteps\n",
                "    BV_folder = f'{og_location}/{participant}/{participant}_FirstSteps/';\n",
                "    \n",
                "    #Loop through each run\n",
                "    for run in range(1, 5):\n",
                "        run_str = f\"{run:02}\"  # Format the value with leading zeros\n",
                "        print(\"Current run:\", run_str)\n",
                "        \n",
                "        #Run folder add on of type: D:\\BV_Data\\306\\306_DCMs\\Functional\\S306_3T_01\n",
                "        run_folderaddon = f'S{participant}_3T_{run_str}';\n",
                "        \n",
                "        # Change the current working directory to get first file name\n",
                "        os.chdir(f'{raw_func_folder}{run_folderaddon}')\n",
                "        \n",
                "        #Run's og functional folder\n",
                "        run_folder = f'{raw_func_folder}{run_folderaddon}';\n",
                "        \n",
                "        #List all the volumes in this run\n",
                "        volume_list = os.listdir();\n",
                "        \n",
                "        #First vol name\n",
                "        first_vol_name = volume_list[0];\n",
                "        \n",
                "        #Number of volumes in this folder\n",
                "        total_vols = len(volume_list);\n",
                "        \n",
                "        #Prefix name like: 306_3T_FoodBrain_Part1L_04\n",
                "        prefix = f'{participant}_3T_FoodBrain_Part1L_{run_str}';\n",
                "\n",
                "        print(\"      Creating FMR...\")        \n",
                "\n",
                "        #Create FMR\n",
                "        doc = brainvoyager.create_mosaic_fmr(first_vol_name, \n",
                "                                            total_vols, \n",
                "                                            0, \n",
                "                                            False, \n",
                "                                            nr_slices, \n",
                "                                            prefix, \n",
                "                                            False, \n",
                "                                            size, \n",
                "                                            size, \n",
                "                                            in_plane_res[0], \n",
                "                                            in_plane_res[1], \n",
                "                                            2, \n",
                "                                            BV_folder)\n",
                "\n",
                "\n",
                "        doc.save_as(f'{BV_folder}{prefix}')\n",
                "\n",
                "        # Preprocess FMR\n",
                "        print(\"      Preprocessing FMR...\")\n",
                "        print(\"        Correcting Slice Timing using Time Table...\")\n",
                "        # 1 = cubic spline; (2 = sinc interpolation, but NOT mentioned in BV 21.4 scripting guide as an option anymore)\n",
                "        # (results of cubic spline and sinc are identical and preferable to linear as linear does some smoothing)\n",
                "        # use cobic spline (or sinc) not linear, because linear smoothes the data a bit and we don't\n",
                "        # want that\n",
                "        # we have multi-band factor 4 data with slice time table\n",
                "        doc.correct_slicetiming_using_timingtable(1)\n",
                "        preprocessed_file_name = doc.preprocessed_fmr_name  # contains full path\n",
                "        doc.close()\n",
                "\n",
                "        doc = brainvoyager.open_document(preprocessed_file_name)\n",
                "        # motion corretion either to self or reference run\n",
                "        ref_vol = 0\n",
                "        print(\"          Motion correction to volume {} of self...\".format(ref_vol))\n",
                "        # doc.CorrectMotionEx(ref_vol, 2, 1, 100, 0, 1)\n",
                "        doc.correct_motion_ext(ref_vol, 2, True, 100, False, False)\n",
                "        #   CorrectMotionEx(0 = align to 1st vol (python indexing), 2 = trilinear detection and sinc interpolation (recommanded), 1 = all voxels are used for motion correction (recommanded) OR 0 = subset of voxels is used,\n",
                "        #                   100 = max number if iterations for correction (recommanded, usually 5 to 10 are needed),\n",
                "        #                   0 = don't create a movie, 0 = no extended log file is saved to disk (would have additional info about iterative motion correction))\n",
                "        doc.preprocessed_fmr_name  # contains full path\n",
                "\n",
                "        ### HIgh pass fitering is done after COPE has been applied\n",
                "\n",
                "        print(\"        Temporal High Pass Filtering with 3 Cycles...\")\n",
                "        # # incluides linear trend removeal\n",
                "        doc.filter_temporal_highpass_glm_fourier(3)\n",
                "        preprocessed_file_name = doc.preprocessed_fmr_name\n",
                "        doc.close()\n",
                "        doc = brainvoyager.open(preprocessed_file_name)  # use 3 cyles cut-off for correction\n",
                "        doc.save_as(f'{prefix}_SCCTBL_3DMCTS_THPGLMF3c.fmr')\n",
                "        \n",
                "    \n",
                "\n",
                "                    "
            ]
        },
        {
            "cell_type": "code",
            "execution_count": -1,
            "metadata": {
            },
            "outputs": [
            ],
            "source": [
                "# Create FMR\n",
                "\n",
                "# CreateDocumentMosaicFMR(file type, name 1st scan, nr of volumes, nr volumes to skip, create AMR (boolean), nr of slices, prefix STC file, MOSAIC rows, MOSAIC rows,\n",
                "# nr of bytes per pixel (2 is standard), saving dir (same as dcm files), nr volumes in single file (=1), in plane resolution X-axis, in plane resolution y-axis)\n",
                "# doc = brainvoyager.CreateDocumentMosaicFMR(\"DICOM\", scans[0], len(\n",
                "#     scans), 0, False, NR_SLICES, prefix, False, size, size, 2, run, 1, IN_PLANE_RESOLUTION[0], IN_PLANE_RESOLUTION[1])\n",
                "\n",
                "#create_mosaic_fmr(first_file, n_volumes, skip_n_volumes, first_volume_amr, n_slices, fmr_stc_filename, big_endian, mosaic_rows, mosaic_cols, slice_rows, slice_cols, bytes_per_pixel, target_folder) -> DocPyBV\n",
                "#Creates and saves a functional FMR document from Siemens DICOM mosaic MRI files; the FMR (header) file references the created data (STC) file.\n",
                "#first_file        (str): Path to first file of a series of MRI files (one file, one mosaic volume).\n",
                "#n_volumes         (int): Number of volumes (time points, mosaic files) of the 4D functional scan.\n",
                "#skip_n_volumes    (int): Number of volumes to skip at the begin of the data (usually 0).\n",
                "#first_volume_amr (bool): Create overlay (AMR) file from first functional volume ('True') or not ('False').\n",
                "#n_slices          (int): Number of slices comprising a 3D functional volume.\n",
                "#fmr_stc_filename  (str): Name of the created FMR (header) and STC (data) file.\n",
                "#big_endian       (bool): Byte order of data, usually little endian ('False'); if detected, value from file header is used.\n",
                "#mosaic_rows       (int): Specifies the number of rows of a the mosaic image. If detected, value from header is used.\n",
                "#mosaic_cols       (int): Specifies the number of columns of a the mosaic image. If detected, value from header is used.\n",
                "#slice_rows        (int): Specifies the number of rows of a single slice (inside mosaic). If detected, value from header is used.\n",
                "#slice_cols        (int): Specifies the number of columns of a single slice. If detected, value from header is used.\n",
                "#bytes_per_pixel   (int): Number of bytes of one pixel value (usually 2). If detected, value from header is used.\n",
                "#target_folder     (str): Path to directory where the data will be stored.\n",
                "#->            (DocPyBV): FMR document object created from specified scanner files.\n",
                "\n",
                "\n",
                "# create_mosaic_fmr(path to 1st scan, nr of volumes, nr volumes to skip, create AMR (boolean), nr of slices, prefix STC file, MOSAIC rows, MOSAIC rows,\n",
                "# in plane resolution X-axis, in plane resolution y-axis, nr of bytes per pixel (2 is standard), saving dir (same as dcm files))\n",
                "#doc = brainvoyager.create_mosaic_fmr(scans[0], \n",
                "#                                     len(scans), \n",
                "#                                     0, \n",
                "#                                     False, \n",
                "#                                     nr_slices, \n",
                "#                                     prefix, \n",
                "#                                     False, \n",
