            "source": [
                "# Import the os module\n",
                "import os\n",
                "from os import listdir\n",
                "from pathlib import Path"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": 200,
            "metadata": {
            },
            "outputs": [
