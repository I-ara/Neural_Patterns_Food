            "source": [
                "## Make MDM\n",
                "\n",
                "#file_list = ['201']\n",
                "\n",
                "for participant in file_list:\n",
                "\n",
                "    header = \"\"\"\n",
                "    FileVersion:          3\n",
                "    TypeOfFunctionalData: VTC\n",
                "\n",
                "    RFX-GLM:              0\n",
                "\n",
                "    PSCTransformation:    1\n",
                "    zTransformation:      0\n",
                "    SeparatePredictors:   3\n",
                "\n",
                "    \"\"\"\n",
                "\n",
                "    #BV folder directory per participant for analysis D:\\BV_Data\\306\\306_FirstSteps\n",
                "    participant_base = f'{BV_data}/{participant}/{participant}_FirstSteps/';\n",
                "    allconds_base = f'{BV_data}/AllcondsAnalysis/';\n",
                "    print(\"Current participant:\", participant) \n",
                "        \n",
                "    mdm_output = f'{allconds_base}participant{participant}_allruns.mdm'\n",
                "\n",
                "    #Gets number of files for mdm, in the per participant case, this is always just one\n",
                "    nr_files = 4;\n",
                "\n",
                "    with open(mdm_output, 'w') as output_file:\n",
                "\n",
                "        output_file.write(header)\n",
                "        output_file.write('NrOfStudies:          {}'.format(nr_files) + \"\\n\")\n",
                "    \n",
                "        #Every file base/prefix\n",
                "        file_base = f'{participant}_3T_FoodBrain_Part2S'\n",
                "        #file_base = f'{participant}_3T_FoodBrain_Part1L'\n",
                "    \n",
                "        #preprocessed prefix\n",
                "        process = \"_SCCTBL_3DMCTS_THPGLMF3c_TAL\"\n",
                "        \n",
                "        #preprocess prefix add on for smudged version\n",
                "        smudge6 = \"_SD3DVSS6.00mm\"\n",
                "\n",
                "        #Loop through each run\n",
                "        for run in range(1, 5):\n",
                "        \n",
                "            run_str = f\"{run:02}\"  # Format the value with leading zeros\n",
                "            print(\"                    Current run:\", run_str) \n",
                "        \n",
                "            file_prefix = f'{participant_base}{file_base}_{run_str}{process}'\n",
                "            sdm_allcondsprefix = f'{allconds_base}{file_base}_{run_str}{process}'\n",
                "        \n",
                "            talvtc_file = f'{file_prefix}{smudge6}.vtc'   \n",
                "            sdm_file = f'{sdm_allcondsprefix}.sdm'\n",
                "        \n",
                "            output_file.write('\"' +talvtc_file+'\" \"'+sdm_file+'\"\\n')\n",
                "            \n",
                "    #Per participant gets original space vmr\n",
                "    vmr_base = f'_IIHC_aTal'\n",
                "    \n",
                "    doc_open = f'{participant_base}{file_base}{vmr_base}.vmr'\n",
                "    \n",
                "    glm_output = f'{allconds_base}participant{participant}_allruns_FFX_AR2.glm'\n",
                "\n",
                "    doc = bv.open(doc_open)\n",
                "\n",
                "    doc.load_multistudy_glm_definition_file(mdm_output)\n",
                "    doc.serial_correlation_correction_level = 2 # 1 -> AR(1), 2 -> AR(2)\n",
                "    doc.psc_transform_studies = False\n",
                "    doc.z_transform_studies = False\n",
                "    doc.z_transform_studies_baseline_only = False\n",
                "    doc.separate_subject_predictors = False\n",
                "    doc.separate_study_predictors = False\n",
                "    doc.compute_multistudy_glm()\n",
                "    doc.save_glm(glm_output)\n",
                "    doc.show_glm()\n",
                "    \n",
                "    doc.close()"
            ]
        },
