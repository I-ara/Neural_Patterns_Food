            "source": [
                "## Creates VTCs\n",
                "\n",
                "#Loop through each participant name\n",
                "for participant in file_list :\n",
                "    \n",
                "    #BV folder for analysis D:\\BV_Data\\306\\306_FirstSteps\n",
                "    participant_base = f'{BV_data}/{participant}/{participant}_FirstSteps/';\n",
                "    print(\"For participant:\", participant)\n",
                "    \n",
                "    file_base =f'{participant}_3T_FoodBrain_Part2S'\n",
                "    \n",
                "    prefix = \"_SCCTBL_3DMCTS_THPGLMF3c_TAL\"\n",
                "\n",
                "    #Per participant gets original space vmr\n",
                "    vmr_base = f'_IIHC_aTal'\n",
                "    \n",
                "    doc_open = f'{participant_base}{file_base}{vmr_base}.vmr'\n",
                "\n",
                "    #Loop through each run\n",
                "    for run in range(1, 5):\n",
                "        \n",
                "        run_str = f\"{run:02}\"  # Format the value with leading zeros\n",
                "        print(\"                    Current run:\", run_str)  \n",
                "        \n",
                "        #doc_vmr = bv.open(doc_open)  \n",
                "        \n",
                "        #attach VTC type 10_3T_FoodBrain_Part2S_01_SCCTBL_3DMCTS_THPGLMF3c_TAL\n",
                "        #doc_vtc = f'{participant_base}{file_base}_{run_str}{prefix}.vtc'\n",
                "        \n",
                "        #doc_vmr.link_vtc(doc_vtc)\n",
                "\n",
                "        #smoothed_vtc_4 = doc_vmr.smooth_spatial(4, 'mm') # saves new file \"X_SD3DVSS4.00mm\"\n",
                "        \n",
                "        #doc_vmr.close()\n",
                "        \n",
                "        #doc_vmr = bv.open(doc_open)  \n",
                "        \n",
                "        #attach VTC type 10_3T_FoodBrain_Part2S_01_SCCTBL_3DMCTS_THPGLMF3c_TAL\n",
                "        #doc_vtc = f'{participant_base}{file_base}_{run_str}{prefix}.vtc'\n",
                "        \n",
                "        #doc_vmr.link_vtc(doc_vtc)\n",
                "\n",
                "        #smoothed_vtc_8 = doc_vmr.smooth_spatial(8, 'mm') # saves new file \"X_SD3DVSS4.00mm\"\n",
                "        \n",
                "        #doc_vmr.close()\n",
                "        \n",
                "        doc_vmr = bv.open(doc_open)  \n",
                "        \n",
                "        #attach VTC type 10_3T_FoodBrain_Part2S_01_SCCTBL_3DMCTS_THPGLMF3c_TAL\n",
                "        doc_vtc = f'{participant_base}{file_base}_{run_str}{prefix}.vtc'\n",
                "        \n",
                "        doc_vmr.link_vtc(doc_vtc)\n",
                "\n",
                "        smoothed_vtc_6 = doc_vmr.smooth_spatial(6, 'mm') # saves new file \"X_SD3DVSS4.00mm\"\n",
                "        \n",
                "        doc_vmr.close()\n",
                "\n",
                "        "
            ]
        },
