            "source": [
                "for participant in file_list:\n",
                "    \n",
                "    print(\"For participant:\", participant)\n",
                "    \n",
                "    #BV folder directory per participant for analysis D:\\BV_Data\\306\\306_FirstSteps\n",
                "    participant_base = f'{BV_data}/{participant}/{participant}_FirstSteps/';\n",
                "    \n",
                "    #Already existant SDM file\n",
                "    sdm_single = f'{participant}_3T_FoodBrain_Part1L'\n",
                "    \n",
                "    #preprocessed prefix\n",
                "    process = \"_SCCTBL_3DMCTS_THPGLMF3c\"\n",
                "\n",
                "    #Per participant gets TAL space vmr prefix/base\n",
                "    vmr_tal = f'{participant_base}{file_base}_IIHC_aTal'\n",
                "\n",
                "    #Open VMR file\n",
                "    doc_open = f'{vmr_tal}.vmr'\n",
                "    doc_vmr = bv.open(doc_open)\n",
                "\n",
                "    #Loop through each run\n",
                "    for run in range(1, 5):\n",
                "        \n",
                "        run_str = f\"{run:02}\"  # Format the value with leading zeros\n",
                "        print(\"                    Current run:\", run_str) \n",
                "        \n",
                "        #VTC expected prefix\n",
                "        vtc_base = f'{participant_base}{file_base}_{run_str}{process}_TAL.vtc'\n",
                "        \n",
                "        #PRT expected file of type 201_run1\n",
                "        prt_file = f'{participant_base}/{participant}_run{run}'\n",
                "        \n",
                "        linked_vtc = doc_vmr.link_vtc(vtc_base)\n",
                "\n",
                "        linked_prt = doc_vmr.link_protocol(prt_file) # only documented as a fmr function\n",
                "        \n",
                "        saved_vtc = doc_vmr.save_vtc(vtc_base) # have to provide file name as str with forward slash; does not take pathlib object\n",
                "        \n",
                "        print(\"saved_vtc: \", saved_vtc)\n",
                "\n",
                "        # create sdm file for VTC\n",
                "        doc_vmr.clear_run_designmatrix()\n",
                "\n",
                "        # add predictors from prt file \n",
                "        doc_vmr.create_run_designmatrix_from_protocol(0, True) #I dont know how this works, it just does\n",
                "\n",
                "        # manually add constant predictor and set that constant is included\n",
                "        doc_vmr.add_predictor(\"Constant\")\n",
                "        doc_vmr.set_predictor_values(\"Constant\", 0, 386, 1.0)\n",
                "        doc_vmr.sdm_contains_constant_predictor = 1 # works\n",
                "\n",
                "        # save sdm file\n",
                "        sdm_path = f'{participant_base}{file_base}_{run_str}{process}_TAL.sdm'\n",
                "        doc_vmr.save_run_designmatrix(sdm_path)\n",
                "\n",
                "    doc_vmr.close()\n",
                "\n",
                "        "
            ]
        }
    ],
    "log_brainvoyager_code": false,
    "metadata": {
    }
}
