            "source": [
                "## Make MDM\n",
                "\n",
                "header = \"\"\"\n",
                "FileVersion:          3\n",
                "TypeOfFunctionalData: VTC\n",
                "\n",
                "RFX-GLM:              1\n",
                "\n",
                "PSCTransformation:    1\n",
                "zTransformation:      0\n",
                "SeparatePredictors:   2\n",
                "\n",
                "\"\"\"\n",
                "\n",
                "mdm_output = f'{BV_data}/template.mdm'\n",
                "\n",
                "#Gets number of files for mdm\n",
                "nr_files = len(file_list)*4;\n",
                "\n",
                "with open(mdm_output, 'w') as output_file:\n",
                "\n",
                "    output_file.write(header)\n",
                "    output_file.write('NrOfStudies:          {}'.format(nr_files) + \"\\n\")\n",
                "\n",
                "    for participant in file_list:\n",
                "    \n",
                "        #BV folder directory per participant for analysis D:\\BV_Data\\306\\306_FirstSteps\n",
                "        participant_base = f'{BV_data}';\n",
                "        print(\"Current participant:\", participant) \n",
                "    \n",
                "        #Every file base/prefix\n",
                "        file_base = f'motNF_P{participant}'\n",
                "    \n",
                "        #preprocessed prefix\n",
                "        process = \"_SCCTBL_3DMCTS_THPGLMF3c_MNI\"\n",
                "\n",
                "        #Loop through each run\n",
                "        for run in range(1, 5):\n",
                "        \n",
                "            run_str = f\"{run:02}\"  # Format the value with leading zeros\n",
                "            print(\"                    Current run:\", run_str) \n",
                "        \n",
                "            file_prefix = f'{participant_base}/{file_base}_RunNF{run_str}{process}'\n",
                "        \n",
                "            mni_vtc_file = f'{file_prefix}.vtc'   \n",
                "            sdm_file = f'{file_prefix}.sdm'\n",
                "        \n",
                "            output_file.write('\"' +mni_vtc_file+'\" \"'+sdm_file+'\"\\n')\n",
                "            \n",
                ""
            ]
        }
    ],
