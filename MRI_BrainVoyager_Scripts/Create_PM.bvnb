            ],
            "source": [
                "counter = 0\n",
                "for participant in file_list:\n",
                "    \n",
                "    vmp_header, vmp_data = bvbabel.vmp.read_vmp(f'{BV_data}/AllcondsAnalysis/P{participant}_hed.vmp')\n",
                "    \n",
                "    if counter == 0:\n",
                "        vmp_merged_data = copy.deepcopy(vmp_data)\n",
                "        vmp_merged_data = vmp_merged_data[:,:,:, None]\n",
                "        vmp_merged_header = copy.deepcopy(vmp_header)\n",
                "    else:\n",
                "        vmp_merged_data = np.concatenate((vmp_merged_data,vmp_data[:,:,:, None]),axis = 3)\n",
                "        vmp_merged_header['Map'].extend(vmp_header['Map'])\n",
                "    counter = counter + 1\n",
                "\n",
                "vmp_merged_header['NrOfSubMaps'] = len(file_list)\n",
                "bvbabel.vmp.write_vmp('AllParticipants_hedoverneut.vmp', vmp_merged_header, vmp_merged_data)"
            ]
        }
    ],
